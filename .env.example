# Optional: set this only if you want REST callers to send Authorization: Bearer <token>
BRIDGE_TOKEN=

# Server settings
HOST=127.0.0.1
PORT=8787

# Browser/session settings
GEMINI_URL=https://gemini.google.com/app
GEMINI_PROFILE_DIR=./profiles/gemini
REAL_BROWSER_PROFILE_DIR=./profiles/real-browser
REAL_BROWSER_DEBUG_PORT=9222
CHROME_CDP_URL=http://127.0.0.1:9222
AUTO_LAUNCH_REAL_BROWSER=true
HEADLESS=false
STUFF_DIR=./stuff
SAVE_STUFF=true
SAVE_PAGE_SCREENSHOT=true
SAVE_MEDIA_ARTIFACTS=true
MAX_ARTIFACT_BYTES=104857600
MIN_IMAGE_ARTIFACT_SIZE=180
LOW_RESOURCE_MODE=true
BROWSER_WINDOW_WIDTH=1100
BROWSER_WINDOW_HEIGHT=740
GEMINI_BROWSER_VISIBILITY=visible
GEMINI_BRING_TO_FRONT=true
GEMINI_BROWSER_VISIBLE_X=80
GEMINI_BROWSER_VISIBLE_Y=80
GEMINI_BROWSER_HIDDEN_X=-32000
GEMINI_BROWSER_HIDDEN_Y=-32000
GEMINI_USE_TEMPORARY_CHATS=true
GEMINI_FRESH_CHAT_EACH_PROMPT=true
GEMINI_AUTO_DELETE_CREATED_CHATS=true
GEMINI_REUSE_BLANK_HOME=true
GEMINI_CAPTURE_MEDIA_REFS_FOR_TEXT=false
GEMINI_RETURN_PROMPT_IN_RESPONSE=true

# Be gentle with the Gemini web UI. This is not an API.
GEMINI_MIN_SECONDS_BETWEEN_PROMPTS=8
GEMINI_DEFAULT_TIMEOUT_MS=180000
GEMINI_DEFAULT_RETRIES=0
GEMINI_RETRY_DELAY_MS=2500
GEMINI_RESPONSE_POLL_MS=1500
GEMINI_MEDIA_POLL_MS=3500
GEMINI_STABLE_RESPONSE_MS=2200
GEMINI_MAX_MEDIA_REFS=50
GEMINI_IDLE_CLOSE_BROWSER_MINUTES=0
ARCHIVE_INDEX_LIMIT=200
